# LLM Configuration
# Primary Gemini API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional Backup Keys for Automated Failover & Rotation
# GEMINI_API_KEY_BACKUP=YOUR_BACKUP_KEY_HERE
# GEMINI_API_KEYS=key1,key2,key3
# GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

LLM_MODEL=gemini-2.5-flash

# Database Configuration
# Local SQLite (Default)
DATABASE_URL=sqlite:///data/college.db

# Production MySQL Example (Uncomment when ready for cloud MySQL)
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/dbname
